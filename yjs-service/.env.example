# Yjs Service Environment Variables
PORT=3000
NODE_ENV=DEV
LOG_LEVEL=info

# Backend API URL (Spring Boot)
BACKEND_URL=http://backend:8080

# Redis Connection (should match main .env)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dummy
REDIS_DATABASE=0

# JWT Configuration (MUST match Spring Boot JWT secret!)
JWT_SECRET=changeme-generate-a-random-32-byte-base64-secret