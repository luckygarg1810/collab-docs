# Yjs Service Environment Variables
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Redis Connection (should match main .env)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_DATABASE=0

# JWT Configuration (MUST match Spring Boot JWT secret!)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-characters-long
